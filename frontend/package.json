    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
